<?xml version="1.0" encoding="utf-8"?>
<!--
  The foreground is a photograph, so there is no monochrome layer: a themed icon paints one layer
  in a single tone, and a photo in that mode is a grey smear. Without the layer the launcher simply
  keeps the full-colour icon, which is the better of the two outcomes.

  The background colour shows only where the mask reaches past the foreground, which the blurred
  bleed baked into the foreground already covers.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
