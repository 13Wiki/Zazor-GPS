<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Matches PhotoStorage and VoiceNoteRecorder: getExternalFilesDir(...) with a filesDir fallback. -->
    <external-files-path
        name="external_photos"
        path="photos/" />
    <external-files-path
        name="external_voice"
        path="voice/" />
    <external-files-path
        name="external_tracks"
        path="tracks/" />
    <external-files-path
        name="external_bundles"
        path="bundles/" />
    <files-path
        name="internal_bundles"
        path="bundles/" />
    <files-path
        name="internal_photos"
        path="photos/" />
    <files-path
        name="internal_voice"
        path="voice/" />
    <files-path
        name="internal_tracks"
        path="tracks/" />
    <!-- PDF reports: written to the cache, because a handed-over report is not kept afterwards. -->
    <cache-path
        name="internal_reports"
        path="reports/" />
</paths>
