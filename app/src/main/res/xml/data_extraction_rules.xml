<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The gallery is deliberately local-only: photos, their database and the PIN never leave
         the device through cloud backup or a device-to-device transfer. -->
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
