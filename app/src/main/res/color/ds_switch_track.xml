<?xml version="1.0" encoding="utf-8"?>
<!-- On is accent, off is outline: the thumb's position alone is too easy to misread at a glance. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/ds_accent" android:state_checked="true" />
    <item android:color="@color/ds_outline" />
</selector>
