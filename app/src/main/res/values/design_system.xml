<?xml version="1.0" encoding="utf-8"?>
<!--
  Design system for the "Стекло" direction. Every screen draws from these names rather than
  literal hex, so the palette moves in one place.
-->
<resources>

    <!-- Surfaces -->
    <color name="ds_background">#0B0F14</color>
    <color name="ds_surface">#141A21</color>
    <color name="ds_surface_raised">#1B222B</color>
    <color name="ds_outline">#26303B</color>

    <!-- Glass sits over a live image: the camera preview and the map. -->
    <color name="ds_glass">#26FFFFFF</color>

    <!--
      Glass over the viewfinder, at the exact opacities the mockups use. White at 14-22 per cent
      for the fills, 20-32 for the hairline around them; they are close to each other on purpose -
      a pill, a card and a track have to read as the same material at different weights.
    -->
    <color name="ds_glass_track">#24FFFFFF</color>
    <color name="ds_glass_card">#26FFFFFF</color>
    <color name="ds_glass_pill">#29FFFFFF</color>
    <color name="ds_glass_chip">#2EFFFFFF</color>
    <color name="ds_glass_shutter">#38FFFFFF</color>
    <color name="ds_glass_edge_track">#33FFFFFF</color>
    <color name="ds_glass_edge_pill">#38FFFFFF</color>
    <color name="ds_glass_edge_card">#3DFFFFFF</color>
    <color name="ds_glass_edge_thumb">#4DFFFFFF</color>
    <color name="ds_glass_edge_shutter">#52FFFFFF</color>

    <!--
      On the dark screens the design builds surfaces out of white at low opacity rather than out
      of solid greys: a card at 6 per cent, an unchosen pill at 9, a round button at 10.
    -->
    <color name="ds_surface_sheer">#0FFFFFFF</color>
    <color name="ds_surface_group">#0DFFFFFF</color>
    <color name="ds_surface_faint">#14FFFFFF</color>
    <color name="ds_grabber">#47FFFFFF</color>
    <color name="ds_sheet_tab_idle">#A8FFFFFF</color>
    <color name="ds_width_dot_idle">#73FFFFFF</color>
    <color name="ds_include_pill_idle">#B3FFFFFF</color>
    <color name="ds_option_hint">#8CFFFFFF</color>
    <color name="ds_caption">#8CFFFFFF</color>
    <!-- The editing sheet's own dark glass, from the mockup. -->
    <color name="ds_sheet">#D1141A21</color>
    <color name="ds_divider_sheer">#12FFFFFF</color>
    <color name="ds_text_dim">#6BFFFFFF</color>
    <color name="ds_surface_pill">#17FFFFFF</color>
    <color name="ds_surface_round">#1AFFFFFF</color>
    <color name="ds_text_faint">#80FFFFFF</color>

    <!-- Text laid on glass is white with alpha, not the grey used on solid surfaces. -->
    <color name="ds_on_glass">#EBFFFFFF</color>
    <color name="ds_on_glass_muted">#B8FFFFFF</color>

    <!-- The dot beside the signal reading: good fix, and the warning colour for a poor one. -->
    <color name="ds_signal_good">#34D07F</color>
    <color name="ds_on_good">#06210F</color>
    <color name="ds_good_surface">#1A34D07F</color>
    <color name="ds_good_edge">#8034D07F</color>
    <color name="ds_good_text">#9BE3BE</color>
    <color name="ds_accuracy_track">#1FFFFFFF</color>
    <color name="ds_glass_strong">#40FFFFFF</color>
    <color name="ds_glass_outline">#3DFFFFFF</color>
    <color name="ds_scrim">#B30B0F14</color>
    <!-- Behind text laid over a photo: dark enough to read on snow, light enough to see through. -->
    <color name="ds_photo_scrim">#8C0B0F14</color>

    <!-- Ink -->
    <color name="ds_text_primary">#FFFFFF</color>
    <color name="ds_text_secondary">#B8C2CC</color>
    <color name="ds_text_muted">#7A8794</color>

    <!-- Accent taken from the launcher icon -->
    <color name="ds_accent">#2F86F6</color>
    <color name="ds_accent_pressed">#1C6ED6</color>
    <color name="ds_accent_soft">#242F86F6</color>
    <color name="ds_on_accent">#FFFFFF</color>

    <!-- Signals -->
    <color name="ds_good">#34D07F</color>
    <color name="ds_warn">#E8A13A</color>
    <color name="ds_danger">#FF5A4E</color>
    <color name="ds_danger_soft">#1FFF5A4E</color>

    <!-- Stamp burned onto the photo -->
    <color name="ds_stamp_scrim">#B3000000</color>

    <!-- A statement the app stands behind, rather than a warning: blue, not red. -->
    <color name="ds_accent_surface">#242F86F6</color>
    <color name="ds_accent_text">#A8CDFF</color>

    <dimen name="ds_radius_card">24dp</dimen>
    <dimen name="ds_radius_control">18dp</dimen>
    <dimen name="ds_radius_sheet">30dp</dimen>
    <dimen name="ds_radius_stamp">32dp</dimen>

    <dimen name="ds_space_1">4dp</dimen>
    <dimen name="ds_space_2">8dp</dimen>
    <dimen name="ds_space_3">12dp</dimen>
    <dimen name="ds_space_4">16dp</dimen>
    <dimen name="ds_space_5">20dp</dimen>
    <dimen name="ds_space_6">24dp</dimen>

    <!-- Never below 44dp: this is used outdoors, in gloves. -->
    <dimen name="ds_touch_min">48dp</dimen>
    <!-- How tall a photo stands on its card, and how tall a panorama does. -->
    <dimen name="ds_accuracy_track_width">54dp</dimen>
    <dimen name="ds_card_photo">168dp</dimen>
    <dimen name="ds_card_photo_wide">116dp</dimen>

    <dimen name="ds_shutter">80dp</dimen>
    <dimen name="ds_icon_button">46dp</dimen>
</resources>
