<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Widget styles for the "Стекло" direction. Layouts reference these rather than repeating
      colour and radius attributes, so a palette change stays a one-file change.
    -->

    <!-- A screen's name, as the design sets it: 24sp at weight 800, tracked slightly tighter. -->
    <!--
      A screen's name, at the mockup's weight. Deliberately a widget style rather than a text
      appearance: a weight asked for inside a text appearance is not honoured, and the heading
      came out at regular next to a 700 subtitle that was set attribute by attribute.
    -->
    <style name="Widget.Zazor.ScreenTitle" parent="">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textFontWeight">800</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Zazor.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/ds_text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Zazor.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/ds_accent_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/ds_on_accent</item>
        <item name="android:textAllCaps">false</item>
        <!--
          Material spaces button text out by .089em, which is a different typeface's convention.
          The design sets its labels at normal spacing, and the extra width was clipping the
          longest of them.
        -->
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">@dimen/ds_touch_min</item>
        <item name="android:paddingStart">@dimen/ds_space_6</item>
        <item name="android:paddingEnd">@dimen/ds_space_6</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Zazor.Button.Ghost">
        <item name="android:background">@drawable/ds_ghost_button</item>
        <item name="android:textColor">@color/ds_text_primary</item>
    </style>

    <!-- A drawing tool as the design tiles it: 56dp tall, 18dp corners, a 24dp glyph. -->
    <style name="Widget.Zazor.PaintTool" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/ds_tool_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">16dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/ds_tool_icon</item>
    </style>

    <!-- What the letter is about. -->
    <style name="Widget.Zazor.TopicPill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/ds_include_pill</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/ds_include_pill_text</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- The fields on the support screen, which the design draws as cards rather than boxes. -->
    <style name="Widget.Zazor.TextInput.Support" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="android:background">@drawable/ds_input_card</item>
        <item name="boxBackgroundMode">none</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintEnabled">false</item>
        <item name="android:textColorHint">@color/ds_hint</item>
    </style>

    <!-- What travels with the photos: a pill that is on or off, as the design has it. -->
    <style name="Widget.Zazor.IncludePill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/ds_include_pill</item>
        <item name="android:drawablePadding">7dp</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:textColor">@color/ds_include_pill_text</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- A caption over a group, as the design sets it. A widget style, for the reason above. -->
    <style name="Widget.Zazor.Caption" parent="">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ds_caption</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- One of the sheet's three modes. -->
    <style name="Widget.Zazor.SheetTab" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/ds_tab_pill</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/ds_sheet_tab_text</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- The two buttons that end an edit. -->
    <style name="Widget.Zazor.Button.Sheet" parent="Widget.Zazor.Button">
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- The pair of buttons the design puts at the foot of the series screen. -->
    <style name="Widget.Zazor.Button.Series" parent="Widget.Zazor.Button">
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- The mode switch's labels: 14sp semibold, as in the mockup. -->
    <style name="TextAppearance.Zazor.Mode" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- A value inside the glass card: 12sp semibold on white 18%, as the mockup draws it. -->
    <style name="Widget.Zazor.GlassChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/ds_glass_chip</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Two buttons sharing one card's width: the roomy padding wraps their labels in half. -->
    <style name="Widget.Zazor.Button.Compact">
        <item name="android:paddingStart">@dimen/ds_space_3</item>
        <item name="android:paddingEnd">@dimen/ds_space_3</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Widget.Zazor.Button.Ghost.Compact">
        <item name="android:paddingStart">@dimen/ds_space_3</item>
        <item name="android:paddingEnd">@dimen/ds_space_3</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Outlined input on a dark ground; the platform default assumes a light one. -->
    <style name="Widget.Zazor.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/ds_radius_control</item>
        <item name="boxCornerRadiusTopEnd">@dimen/ds_radius_control</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/ds_radius_control</item>
        <item name="boxCornerRadiusBottomStart">@dimen/ds_radius_control</item>

        <item name="boxStrokeColor">@color/ds_outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeErrorColor">@color/ds_danger</item>

        <item name="hintTextColor">@color/ds_text_muted</item>
        <item name="android:textColorHint">@color/ds_text_muted</item>
        <item name="endIconTint">@color/ds_text_secondary</item>

        <item name="errorEnabled">true</item>
        <item name="errorIconDrawable">@null</item>
        <item name="errorTextColor">@color/ds_danger</item>
    </style>

    <style name="Widget.Zazor.TextInput.EditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- Kept so screens not yet migrated still resolve. -->
    <style name="Stromee.Widget.Design.TextInputLayout" parent="Widget.Zazor.TextInput" />

    <!-- The corner the design rounds a launcher icon's preview to. -->
    <style name="ShapeAppearance.Zazor.AliasTile" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <!-- One fact about a reviewed frame: date, time, or how tight the fix was. -->
    <style name="Widget.Zazor.PanoChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/ds_chip_soft</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textColor">@color/ds_text_chip</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Button.Primary" parent="Widget.Zazor.Button" />

    <style name="DialogStyle" parent="Theme.Zazor.BottomSheet" />
</resources>
