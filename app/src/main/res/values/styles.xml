<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Widget styles for the "Стекло" direction. Layouts reference these rather than repeating
      colour and radius attributes, so a palette change stays a one-file change.
    -->

    <style name="TextAppearance.Zazor.Screen" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Zazor.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/ds_text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Zazor.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/ds_accent_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/ds_on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">@dimen/ds_touch_min</item>
        <item name="android:paddingStart">@dimen/ds_space_6</item>
        <item name="android:paddingEnd">@dimen/ds_space_6</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Zazor.Button.Ghost">
        <item name="android:background">@drawable/ds_ghost_button</item>
        <item name="android:textColor">@color/ds_text_primary</item>
    </style>

    <!-- Outlined input on a dark ground; the platform default assumes a light one. -->
    <style name="Widget.Zazor.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/ds_radius_control</item>
        <item name="boxCornerRadiusTopEnd">@dimen/ds_radius_control</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/ds_radius_control</item>
        <item name="boxCornerRadiusBottomStart">@dimen/ds_radius_control</item>

        <item name="boxStrokeColor">@color/ds_outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeErrorColor">@color/ds_danger</item>

        <item name="hintTextColor">@color/ds_text_muted</item>
        <item name="android:textColorHint">@color/ds_text_muted</item>
        <item name="endIconTint">@color/ds_text_secondary</item>

        <item name="errorEnabled">true</item>
        <item name="errorIconDrawable">@null</item>
        <item name="errorTextColor">@color/ds_danger</item>
    </style>

    <style name="Widget.Zazor.TextInput.EditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- Kept so screens not yet migrated still resolve. -->
    <style name="Stromee.Widget.Design.TextInputLayout" parent="Widget.Zazor.TextInput" />

    <style name="Button.Primary" parent="Widget.Zazor.Button" />

    <style name="DialogStyle" parent="Theme.Zazor.BottomSheet" />
</resources>
