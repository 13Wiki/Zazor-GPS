<?xml version="1.0" encoding="utf-8"?>
<!--
  Handing the photos over. Every route here works with no server and no account: straight to a
  messenger, as an archive, or as a PDF report. Nothing is uploaded anywhere by the app itself.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/ds_round_button"
            android:contentDescription="@string/back"
            android:padding="13dp"
            android:src="@drawable/ic_close"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/ds_text_primary" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:text="@string/share_title"
            style="@style/Widget.Zazor.ScreenTitle"
            app:layout_constraintBottom_toBottomOf="@id/ivClose"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivClose"
            app:layout_constraintTop_toTopOf="@id/ivClose" />

        <!-- What is being sent: the frames themselves, how many, how big, how good. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/ds_card_sheer"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivClose">

            <ImageView
                android:id="@+id/ivStackThird"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="88dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:background="@color/ds_surface_raised" />

            <ImageView
                android:id="@+id/ivStackSecond"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="44dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:background="@color/ds_surface" />

            <ImageView
                android:id="@+id/ivStackFirst"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/photo"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:background="@color/ds_surface_raised" />

            <TextView
                android:id="@+id/tvSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/manrope"
                android:textColor="@color/ds_text_primary"
                android:textFontWeight="700"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/tvSummaryDetail"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivStackFirst"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="4 снимка" />

            <TextView
                android:id="@+id/tvSummaryDetail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/manrope"
                android:textColor="@color/ds_text_faint"
                android:textFontWeight="500"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/tvSummary"
                app:layout_constraintStart_toStartOf="@id/tvSummary"
                app:layout_constraintTop_toBottomOf="@id/tvSummary"
                tools:text="3,8 МБ · лучшая точность ±3 м" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tvIncludeLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="18dp"
            style="@style/Widget.Zazor.Caption"
            android:text="@string/share_include"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clSummary" />

        <!--
          Pills rather than switches: four of them fit on two lines, they say what is coming along
          in the same words the receiver will see, and a tap is a tap.
        -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgInclude"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvIncludeLabel">

            <TextView
                android:id="@+id/swCoordinates"
                style="@style/Widget.Zazor.IncludePill"
                android:text="@string/share_include_coordinates" />

            <TextView
                android:id="@+id/swVoice"
                style="@style/Widget.Zazor.IncludePill"
                android:text="@string/share_include_voice" />

            <TextView
                android:id="@+id/swAddress"
                style="@style/Widget.Zazor.IncludePill"
                android:text="@string/share_include_address" />

            <TextView
                android:id="@+id/swTrack"
                style="@style/Widget.Zazor.IncludePill"
                android:text="@string/share_include_track" />

        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/tvHowLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="18dp"
            style="@style/Widget.Zazor.Caption"
            android:text="@string/share_how"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cgInclude" />

        <include
            android:id="@+id/optMessenger"
            layout="@layout/item_share_option"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvHowLabel" />

        <include
            android:id="@+id/optBundle"
            layout="@layout/item_share_option"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/optMessenger" />

        <include
            android:id="@+id/optReport"
            layout="@layout/item_share_option"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/optBundle" />

        <ProgressBar
            android:id="@+id/pbPreparing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/ds_accent"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/optReport"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
