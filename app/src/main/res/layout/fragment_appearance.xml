<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/ds_space_6">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="@dimen/ds_icon_button"
            android:layout_height="@dimen/ds_icon_button"
            android:layout_margin="@dimen/ds_space_4"
            android:background="@drawable/ds_ghost_button"
            android:contentDescription="@string/back"
            android:padding="13dp"
            android:src="@drawable/ic_baseline_arrow_back_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/ds_text_primary" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_3"
            android:text="@string/appearance_title"
            android:textColor="@color/ds_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/ivBack"
            app:layout_constraintStart_toEndOf="@id/ivBack"
            app:layout_constraintTop_toTopOf="@id/ivBack" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAppearances"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_3"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ds_space_4"
            android:paddingEnd="@dimen/ds_space_4"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/ivBack" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/ds_space_4"
            android:lineSpacingExtra="4dp"
            android:text="@string/appearance_hint"
            android:textColor="@color/ds_text_muted"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rvAppearances" />

        <TextView
            android:id="@+id/tvWipeLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_4"
            android:layout_marginEnd="@dimen/ds_space_4"
            android:layout_marginTop="@dimen/ds_space_4"
            android:text="@string/wipe_code_label"
            android:textColor="@color/ds_danger"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvHint" />

        <TextView
            android:id="@+id/tvWipeHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/ds_space_4"
            android:lineSpacingExtra="5dp"
            android:text="@string/wipe_code_hint"
            android:textColor="@color/ds_text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvWipeLabel" />

        <TextView
            android:id="@+id/tvWipeCode"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/ds_space_4"
            android:layout_marginEnd="@dimen/ds_space_4"
            android:background="@drawable/ds_surface_card"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/ds_space_4"
            android:paddingEnd="@dimen/ds_space_4"
            android:textColor="@color/ds_text_primary"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvWipeHint" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
