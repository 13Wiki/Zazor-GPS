<?xml version="1.0" encoding="utf-8"?>
<!--
  Capture screen. The frame runs edge to edge and every control floats over it: the white bars
  that used to squeeze the viewfinder into a strip are what dated the app.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/flContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background"
    tools:context=".ui.photo.PhotoActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/vCamera"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <!--
      The top row of the design: how good the fix is, and everything else this screen can do
      behind one button. Both are glass at the mockup's weight - white 16 per cent over a 22 per
      cent hairline - because they lie over a live frame that can be any colour at all.
    -->
    <LinearLayout
        android:id="@+id/llSignal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/ds_glass_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <View
            android:id="@+id/vSignalDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="9dp"
            android:background="@drawable/ds_signal_dot" />

        <TextView
            android:id="@+id/tvSignal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope"
            android:textFontWeight="600"
            android:textColor="@color/ds_text_primary"
            android:textSize="13sp"
            tools:text="Сигнал точный · 4 м" />

    </LinearLayout>

    <ImageView
        android:id="@+id/ivMenu"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/ds_glass_pill"
        android:contentDescription="@string/camera_menu"
        android:padding="12dp"
        android:src="@drawable/ic_menu_lines"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      What the next frame will be stamped with, laid out as the design's card: the point, the
      street, then the values as chips, then the note. It answers "will this photo carry the
      address?" before the shutter rather than after it.
    -->
    <LinearLayout
        android:id="@+id/llStampPreview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/ds_glass_card"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llSignal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/ds_card_icon"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_baseline_location_24"
                app:tint="@color/ds_on_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStampCoordinates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope"
                    android:textFontWeight="700"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="16sp"
                    tools:text="55.755826, 37.617300" />

                <TextView
                    android:id="@+id/tvStampAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/manrope"
                    android:textFontWeight="500"
                    android:maxLines="2"
                    android:textColor="@color/ds_on_glass_muted"
                    android:textSize="13sp"
                    tools:text="Ленинский просп. 32, Москва" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llStampChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStampDate"
                style="@style/Widget.Zazor.GlassChip"
                tools:text="03.09.2026" />

            <TextView
                android:id="@+id/tvStampTime"
                style="@style/Widget.Zazor.GlassChip"
                android:layout_marginStart="8dp"
                tools:text="15:30" />

            <TextView
                android:id="@+id/tvStampAccuracy"
                style="@style/Widget.Zazor.GlassChip"
                android:layout_marginStart="8dp"
                tools:text="±4 м" />

            <TextView
                android:id="@+id/tvStampSeries"
                style="@style/Widget.Zazor.GlassChip"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                tools:text="Серия · 3 кадра"
                tools:visibility="visible" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvStampNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/manrope"
            android:textFontWeight="500"
            android:textColor="@color/ds_on_glass"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Камень у просеки, 40 м на СВ"
            tools:visibility="visible" />

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ds_background"
            android:contentDescription="@string/photo"
            android:scaleType="centerInside"
            android:visibility="invisible" />

        <com.gps.zazor.views.EditorView
            android:id="@+id/evDroidArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />

        <com.gps.zazor.views.DrawView
            android:id="@+id/vDraw"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="invisible" />

        <com.gps.zazor.views.NotesDragView
            android:id="@+id/dvNotes"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!--
          Shown on a panorama and only until the first pin is placed: a wide frame is where a
          marker earns its keep, and an instruction that stays on screen forever is noise.
        -->
        <TextView
            android:id="@+id/tvMarkerHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_4"
            android:layout_marginEnd="@dimen/ds_space_4"
            android:layout_marginTop="@dimen/ds_space_4"
            android:background="@drawable/ds_photo_pill"
            android:paddingStart="@dimen/ds_space_4"
            android:paddingEnd="@dimen/ds_space_4"
            android:paddingTop="@dimen/ds_space_3"
            android:paddingBottom="@dimen/ds_space_3"
            android:text="@string/panorama_marker_hint"
            android:textColor="@color/ds_text_primary"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--
      Editing controls take the same corner once a shot is on screen. They are declared after the
      preview container on purpose: declared before it, the full-screen preview was drawn over them
      and took their touches, so Back and Clear all were invisible and did nothing.
    -->
    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_margin="@dimen/ds_space_4"
        android:background="@drawable/ds_round_button"
        android:contentDescription="@string/back"
        android:padding="13dp"
        android:src="@drawable/ic_back_line"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/ds_text_primary" />

    <TextView
        android:id="@+id/tvClearAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/ds_space_4"
        android:background="@drawable/ds_viewfinder_pill"
        android:paddingStart="@dimen/ds_space_4"
        android:paddingEnd="@dimen/ds_space_4"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/clear_all"
        android:textColor="@color/ds_text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      The panorama's review screen, as the design draws it. It replaces the editing sheet on the
      wide tab: the frame sits in a band with the fix under it and two buttons at the foot, rather
      than filling the screen behind a sheet of tabs. The frame above is the same preview
      container the other tabs use, re-laid into the band while this is up.
    -->
    <LinearLayout
        android:id="@+id/llPanoTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/ivBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivBack">

        <TextView
            android:id="@+id/tvPanoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope"
            android:text="@string/panorama"
            android:textColor="@color/ds_text_primary"
            android:textFontWeight="700"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPanoBearing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope"
            android:textColor="@color/ds_signal_good"
            android:textFontWeight="600"
            android:textSize="12sp"
            tools:text="обзор 214°" />

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clPanoCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/ds_card_pano"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/tvPanoHint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clPreviewContainer">

        <ImageView
            android:id="@+id/ivPanoPin"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/ds_pin_tile"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_pin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/ds_on_accent" />

        <TextView
            android:id="@+id/tvPanoCoordinates"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/manrope"
            android:maxLines="1"
            android:textColor="@color/ds_text_primary"
            android:textFontWeight="700"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivPanoPin"
            app:layout_constraintTop_toTopOf="@id/ivPanoPin"
            tools:text="55.755826, 37.617300" />

        <TextView
            android:id="@+id/tvPanoAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/manrope"
            android:maxLines="1"
            android:textColor="@color/ds_text_note"
            android:textFontWeight="500"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="@id/tvPanoCoordinates"
            app:layout_constraintStart_toStartOf="@id/tvPanoCoordinates"
            app:layout_constraintTop_toBottomOf="@id/tvPanoCoordinates"
            tools:text="Ленинский просп. 32" />

        <LinearLayout
            android:id="@+id/llPanoChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivPanoPin">

            <TextView
                android:id="@+id/tvPanoDate"
                style="@style/Widget.Zazor.PanoChip"
                tools:text="03.09.2026" />

            <TextView
                android:id="@+id/tvPanoTime"
                style="@style/Widget.Zazor.PanoChip"
                android:layout_marginStart="8dp"
                tools:text="15:34" />

            <TextView
                android:id="@+id/tvPanoAccuracy"
                style="@style/Widget.Zazor.PanoChip"
                android:layout_marginStart="8dp"
                tools:text="±4 м" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvPanoHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp"
        android:fontFamily="@font/manrope"
        android:lineSpacingExtra="6sp"
        android:text="@string/panorama_marker_hint"
        android:textColor="@color/ds_text_note"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bPanoMark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/bPanoMark"
        style="@style/Widget.Zazor.Button.Sheet"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/ds_ghost_button_pano"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="@string/panorama_mark"
        android:textColor="@color/ds_text_primary"
        android:visibility="gone"
        app:icon="@drawable/ic_pin"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="20dp"
        app:iconTint="@color/ds_text_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bPanoSave"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/bPanoSave"
        style="@style/Widget.Zazor.Button.Sheet"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/ds_accent_button_privacy"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:text="@string/panorama_save"
        android:textFontWeight="700"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/bPanoMark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/bPanoMark"
        app:layout_constraintTop_toTopOf="@id/bPanoMark" />

</androidx.constraintlayout.widget.ConstraintLayout>
