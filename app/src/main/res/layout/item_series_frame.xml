<?xml version="1.0" encoding="utf-8"?>
<!--
  One frame of an approach: what it shows, where it was taken from and how good the fix was. The
  frame the series takes its coordinate from wears a badge, because that is the number a receiver
  will type into a navigator.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clFrame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/ds_space_2"
    android:background="@drawable/ds_surface_card"
    android:padding="@dimen/ds_space_3">

    <androidx.cardview.widget.CardView
        android:id="@+id/cvImage"
        android:layout_width="96dp"
        android:layout_height="96dp"
        app:cardCornerRadius="@dimen/ds_radius_control"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/photo"
            android:scaleType="centerCrop" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_3"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/ds_text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tvBest"
        app:layout_constraintStart_toEndOf="@id/cvImage"
        app:layout_constraintTop_toTopOf="@id/cvImage"
        tools:text="Общий план · опушка" />

    <TextView
        android:id="@+id/tvBest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/ds_badge"
        android:paddingStart="@dimen/ds_space_3"
        android:paddingEnd="@dimen/ds_space_3"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="@string/series_best_badge"
        android:textColor="@color/ds_on_accent"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/cvImage"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvCoordinates"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_2"
        android:textColor="@color/ds_text_secondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvTitle"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        tools:text="55.755826, 37.617300" />

    <TextView
        android:id="@+id/tvAccuracy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/ds_text_muted"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvTitle"
        app:layout_constraintTop_toBottomOf="@id/tvCoordinates"
        tools:text="±12 м · 15:30" />

</androidx.constraintlayout.widget.ConstraintLayout>
