<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clPaintContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_5"
        android:layout_marginBottom="72dp"
        app:behavior_hideable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <ImageView
            android:id="@+id/ivCircle"
            android:layout_width="@dimen/ds_touch_min"
            android:layout_height="@dimen/ds_touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/paint"
            android:focusable="true"
            android:padding="@dimen/ds_space_3"
            android:src="@drawable/ic_circle"
            app:layout_constraintEnd_toStartOf="@id/ivLine"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivLine"
            android:layout_width="@dimen/ds_touch_min"
            android:layout_height="@dimen/ds_touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/paint"
            android:focusable="true"
            android:padding="@dimen/ds_space_3"
            android:src="@drawable/ic_paint_selected"
            app:layout_constraintEnd_toStartOf="@id/ivArrow"
            app:layout_constraintStart_toEndOf="@id/ivCircle"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivArrow"
            android:layout_width="@dimen/ds_touch_min"
            android:layout_height="@dimen/ds_touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/paint"
            android:focusable="true"
            android:padding="@dimen/ds_space_3"
            android:src="@drawable/ic_arrow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivLine"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPaintColorPicker"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="@dimen/ds_space_4"
            android:paddingStart="@dimen/ds_space_5"
            android:paddingEnd="@dimen/ds_space_5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivArrow" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
