<?xml version="1.0" encoding="utf-8"?>
<!--
  Capture host. The pager fills the window and the controls float over it inside a scrim, so the
  frame is never boxed in by opaque panels.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.photo.PhotoActivity">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clPhotoPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ds_bottom_scrim"
            android:paddingTop="56dp"
            android:paddingBottom="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Collage layout picker: only the collage tab shows it. -->
            <LinearLayout
                android:id="@+id/clCollageGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ds_glass_pill"
                android:orientation="horizontal"
                android:padding="@dimen/ds_space_1"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivGridHorizontal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/collage"
                    android:focusable="true"
                    android:padding="11dp"
                    android:src="@drawable/ic_grid_horizontal"
                    app:tint="@color/ds_text_primary" />

                <ImageView
                    android:id="@+id/ivGridVertical"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/collage"
                    android:focusable="true"
                    android:padding="11dp"
                    android:src="@drawable/ic_vertical_grid"
                    app:tint="@color/ds_text_primary" />

                <ImageView
                    android:id="@+id/ivGrid"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/collage"
                    android:focusable="true"
                    android:padding="11dp"
                    android:src="@drawable/ic_grid"
                    app:tint="@color/ds_text_primary" />
            </LinearLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tlPhotos"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/ds_space_3"
                android:background="@drawable/ds_mode_track"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/clCollageGrid"
                app:tabBackground="@drawable/ds_mode_indicator"
                app:tabGravity="center"
                app:tabIndicator="@null"
                app:tabPaddingEnd="@dimen/ds_space_4"
                app:tabPaddingStart="@dimen/ds_space_4"
                app:tabRippleColor="@null"
                app:tabSelectedTextColor="@color/ds_background"
                app:tabTextColor="@color/ds_text_secondary" />

            <ImageView
                android:id="@+id/ivLastPhoto"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="32dp"
                android:background="@drawable/ds_ghost_button"
                android:contentDescription="@string/labels"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="@id/ivCapture"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/ivCapture" />

            <ImageView
                android:id="@+id/ivCapture"
                android:layout_width="@dimen/ds_shutter"
                android:layout_height="@dimen/ds_shutter"
                android:layout_marginTop="@dimen/ds_space_5"
                android:background="@drawable/ds_shutter"
                android:contentDescription="@string/photo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tlPhotos" />

            <ImageView
                android:id="@+id/ivFlip"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/ds_ghost_button"
                android:contentDescription="@string/photo"
                android:padding="15dp"
                android:src="@drawable/ic_flip"
                app:layout_constraintBottom_toBottomOf="@id/ivCapture"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/ivCapture"
                app:tint="@color/ds_text_primary" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include layout="@layout/bottom_sheet_add_note" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
