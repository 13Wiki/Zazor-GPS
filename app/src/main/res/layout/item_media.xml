<?xml version="1.0" encoding="utf-8"?>
<!--
  One photo, as the design draws it: the frame itself, with the coordinates over its top-left
  corner and the heading over the top-right, then a line saying what it is and when and where it
  was taken.

  The card is white at six per cent on the dark ground rather than a solid grey - that is what
  keeps a page of them from reading as a stack of boxes.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clPhoto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/ds_surface_sheer"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="0dp"
            android:layout_height="168dp"
            android:contentDescription="@string/photo"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:background="@color/ds_surface_raised" />

        <!-- The same coordinates that are burned onto the picture, legible over the thumbnail. -->
        <TextView
            android:id="@+id/tvPreviewCoordinates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="14dp"
            android:background="@drawable/ds_photo_pill"
            android:fontFamily="@font/manrope"
            android:textFontWeight="700"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/ds_text_primary"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="55.755826, 37.617300"
            tools:visibility="visible" />

        <!-- A panorama says which way it looked; opposite the coordinates, as in the design. -->
        <TextView
            android:id="@+id/tvBearing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="14dp"
            android:background="@drawable/ds_photo_pill"
            android:fontFamily="@font/manrope"
            android:textFontWeight="700"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:textColor="@color/ds_text_primary"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="214°"
            tools:visibility="visible" />

        <!-- A frame of an approach series says so, and opens the series. -->
        <TextView
            android:id="@+id/tvSeries"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="14dp"
            android:background="@drawable/ds_photo_pill"
            android:fontFamily="@font/manrope"
            android:textFontWeight="700"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:textColor="@color/ds_text_primary"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/ivPreview"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Серия · 4 кадра"
            tools:visibility="visible" />

        <CheckBox
            android:id="@+id/cbSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/ivPreview"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:fontFamily="@font/manrope"
            android:textFontWeight="700"
            android:textStyle="bold"
            android:maxLines="1"
            android:textColor="@color/ds_text_primary"
            android:textSize="15sp"
            app:layout_constraintEnd_toStartOf="@id/ivVoiceNote"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivPreview"
            tools:text="Камень у просеки, 40 м на СВ" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="14dp"
            android:ellipsize="end"
            android:fontFamily="@font/manrope"
            android:textFontWeight="500"
            android:maxLines="1"
            android:textColor="@color/ds_text_faint"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/tvName"
            app:layout_constraintStart_toStartOf="@id/tvName"
            app:layout_constraintTop_toBottomOf="@id/tvName"
            tools:text="03.09.2026 · 15:30 · Ленинский просп. 32" />

        <ImageView
            android:id="@+id/ivVoiceNote"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="@string/voice_note_record"
            android:src="@drawable/ic_note"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/ivShare"
            app:layout_constraintEnd_toStartOf="@id/ivShare"
            app:layout_constraintTop_toTopOf="@id/ivShare"
            app:tint="@color/ds_accent" />

        <ImageView
            android:id="@+id/ivShare"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/share"
            android:src="@drawable/ic_share_nodes"
            app:layout_constraintBottom_toBottomOf="@id/tvDate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvName"
            app:tint="@color/ds_accent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
