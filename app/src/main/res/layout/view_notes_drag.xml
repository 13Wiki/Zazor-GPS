<?xml version="1.0" encoding="utf-8"?>
<!--
  The stamp that gets burned into the photo. It is dragged over the frame, so it carries its own
  scrim: white text on an unknown background would be unreadable half the time.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/llNotesContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="160dp"
        android:background="@drawable/ds_stamp"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_space_5"
        android:paddingEnd="@dimen/ds_space_5"
        android:paddingTop="@dimen/ds_space_4"
        android:paddingBottom="@dimen/ds_space_4"
        android:visibility="invisible"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvLat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ds_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="50.450100" />

        <TextView
            android:id="@+id/tvLong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ds_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="30.523400" />

        <TextView
            android:id="@+id/tvAccuracy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ds_text_secondary"
            android:textSize="13sp"
            tools:text="± 5 м" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ds_space_2"
                android:textColor="@color/ds_text_secondary"
                android:textSize="13sp"
                tools:text="05.10.26" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ds_text_secondary"
                android:textSize="13sp"
                tools:text="14:32" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_1"
            android:maxWidth="260dp"
            android:textColor="@color/ds_text_primary"
            android:textSize="14sp"
            tools:text="Труба у второго столба" />
    </LinearLayout>
</FrameLayout>
