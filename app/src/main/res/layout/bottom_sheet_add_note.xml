<?xml version="1.0" encoding="utf-8"?>
<!--
  One sheet, three modes: note text, freehand marks, and text on the frame. The mode icons sit in
  a row along the bottom so a thumb reaches them without leaving the sheet.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ds_surface"
    android:minHeight="290dp"
    android:paddingBottom="28dp"
    app:behavior_hideable="true"
    app:behavior_peekHeight="0dp"
    app:layout_behavior="@string/bottom_sheet_behavior">

    <View
        android:id="@+id/vGrabber"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginTop="@dimen/ds_space_3"
        android:background="@drawable/ds_glass_pill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_5"
        android:layout_marginTop="@dimen/ds_space_4"
        android:text="@string/notes"
        android:textAppearance="@style/TextAppearance.Zazor.Screen"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vGrabber" />

    <include layout="@layout/include_notes_content" />

    <include layout="@layout/include_text_content" />

    <include layout="@layout/include_paint_content" />

    <TextView
        android:id="@+id/tvCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_5"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="@dimen/ds_touch_min"
        android:gravity="center_vertical"
        android:text="@string/cancel"
        android:textColor="@color/ds_text_secondary"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ivNote"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilNote"
        app:layout_constraintVertical_bias="1" />

    <ImageView
        android:id="@+id/ivNote"
        android:layout_width="@dimen/ds_icon_button"
        android:layout_height="@dimen/ds_icon_button"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/notes"
        android:focusable="true"
        android:padding="11dp"
        android:src="@drawable/selector_note"
        app:layout_constraintBottom_toBottomOf="@id/tvCancel"
        app:layout_constraintEnd_toStartOf="@id/ivPaint"
        app:layout_constraintStart_toEndOf="@id/tvCancel"
        app:layout_constraintTop_toTopOf="@id/tvCancel" />

    <ImageView
        android:id="@+id/ivPaint"
        android:layout_width="@dimen/ds_icon_button"
        android:layout_height="@dimen/ds_icon_button"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/paint"
        android:focusable="true"
        android:padding="11dp"
        android:src="@drawable/selector_paint"
        app:layout_constraintBottom_toBottomOf="@id/tvCancel"
        app:layout_constraintEnd_toStartOf="@id/ivText"
        app:layout_constraintStart_toEndOf="@id/ivNote"
        app:layout_constraintTop_toTopOf="@id/tvCancel" />

    <ImageView
        android:id="@+id/ivText"
        android:layout_width="@dimen/ds_icon_button"
        android:layout_height="@dimen/ds_icon_button"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/text"
        android:focusable="true"
        android:padding="11dp"
        android:src="@drawable/selector_text"
        app:layout_constraintBottom_toBottomOf="@id/tvCancel"
        app:layout_constraintEnd_toStartOf="@id/tvDone"
        app:layout_constraintStart_toEndOf="@id/ivPaint"
        app:layout_constraintTop_toTopOf="@id/tvCancel" />

    <TextView
        android:id="@+id/tvDone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/ds_space_5"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ds_touch_min"
        android:text="@string/done"
        android:textColor="@color/ds_accent"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@id/ivText"
        app:layout_constraintTop_toBottomOf="@id/tilNote"
        app:layout_constraintVertical_bias="1" />
</androidx.constraintlayout.widget.ConstraintLayout>
