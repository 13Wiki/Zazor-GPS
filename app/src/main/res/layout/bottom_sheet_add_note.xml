<?xml version="1.0" encoding="utf-8"?>
<!--
  One sheet, three modes: note text, freehand marks, and text on the frame.

  The modes are pills at the top of the sheet, as the design has them, rather than icons along the
  bottom: what is being edited is the first thing to read, and the last thing on the sheet should
  be the two buttons that end the editing.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ds_sheet"
    android:minHeight="290dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp"
    app:behavior_hideable="true"
    app:behavior_peekHeight="0dp"
    app:layout_behavior="@string/bottom_sheet_behavior">

    <View
        android:id="@+id/vGrabber"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/ds_grabber"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/llTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/ds_tab_track"
        android:orientation="horizontal"
        android:padding="5dp"
        app:layout_constraintTop_toBottomOf="@id/vGrabber">

        <TextView
            android:id="@+id/tvTabNote"
            style="@style/Widget.Zazor.SheetTab"
            android:text="@string/notes" />

        <TextView
            android:id="@+id/tvTabPaint"
            style="@style/Widget.Zazor.SheetTab"
            android:text="@string/paint" />

        <TextView
            android:id="@+id/tvTabText"
            style="@style/Widget.Zazor.SheetTab"
            android:text="@string/text" />

    </LinearLayout>

    <!-- What the sheet holds in each mode; only one of the three is ever on screen. -->
    <include layout="@layout/include_notes_content" />

    <include layout="@layout/include_text_content" />

    <include layout="@layout/include_paint_content" />

    <Button
        android:id="@+id/tvCancel"
        style="@style/Widget.Zazor.Button.Sheet"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/ds_ghost_button_sheet"
        android:text="@string/cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvDone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clPaintContainer"
        app:layout_constraintVertical_bias="1" />

    <Button
        android:id="@+id/tvDone"
        style="@style/Widget.Zazor.Button.Sheet"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/ds_accent_button_sheet"
        android:text="@string/done"
        android:textFontWeight="700"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvCancel"
        app:layout_constraintTop_toTopOf="@id/tvCancel"
        tools:ignore="DuplicateSpeakableTextCheck" />

</androidx.constraintlayout.widget.ConstraintLayout>
