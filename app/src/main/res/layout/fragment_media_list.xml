<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background">

    <!--
      The header of the design: a round button, the title at 24sp, and the screen's own actions on
      the right - the last of them accent, because sending is what the gallery is for.
    -->
    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/ds_round_button"
        android:contentDescription="@string/back"
        android:padding="13dp"
        android:src="@drawable/ic_back_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/ds_text_primary" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/manrope"
        android:letterSpacing="-0.02"
        android:textFontWeight="800"
        android:textStyle="bold"
        android:text="@string/labels"
        android:textColor="@color/ds_text_primary"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@id/ivBack"
        app:layout_constraintEnd_toStartOf="@id/ivOutings"
        app:layout_constraintStart_toEndOf="@id/ivBack"
        app:layout_constraintTop_toTopOf="@id/ivBack" />

    <ImageView
        android:id="@+id/ivOutings"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/ds_round_button"
        android:contentDescription="@string/outings_title"
        android:padding="13dp"
        android:src="@drawable/ic_home_outline"
        app:layout_constraintBottom_toBottomOf="@id/ivBack"
        app:layout_constraintEnd_toStartOf="@id/ivExport"
        app:layout_constraintTop_toTopOf="@id/ivBack"
        app:tint="@color/ds_text_primary" />

    <ImageView
        android:id="@+id/ivExport"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/ds_round_button_accent"
        android:contentDescription="@string/share"
        android:padding="13dp"
        android:src="@drawable/ic_share_nodes"
        app:layout_constraintBottom_toBottomOf="@id/ivBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_goneMarginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/ivBack"
        app:tint="@color/ds_on_accent" />

    <!-- Both appear only in selection mode: send the ticked photos, or remove them. -->
    <ImageView
        android:id="@+id/ivDeleteSelected"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/ds_round_button"
        android:contentDescription="@string/delete_selected"
        android:padding="13dp"
        android:src="@drawable/ic_baseline_delete_24"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/ivBack"
        app:layout_constraintEnd_toStartOf="@id/ivShare"
        app:layout_constraintTop_toTopOf="@id/ivBack"
        app:tint="@color/ds_danger" />

    <ImageView
        android:id="@+id/ivShare"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/ds_round_button_accent"
        android:contentDescription="@string/share"
        android:padding="13dp"
        android:src="@drawable/ic_share_nodes"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/ivBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivBack"
        app:tint="@color/ds_on_accent" />

    <!--
      Three ways to narrow a long feed, and the only three worth having here: everything, the shots
      someone marked up, and the wide frames. A filter is a pill, like every other choice in the app.
    -->
    <LinearLayout
        android:id="@+id/llFilters"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivBack">

        <TextView
            android:id="@+id/tvFilterAll"
            style="@style/Widget.Zazor.FilterPill"
            android:text="@string/filter_all" />

        <TextView
            android:id="@+id/tvFilterMarked"
            style="@style/Widget.Zazor.FilterPill"
            android:layout_marginStart="8dp"
            android:text="@string/filter_marked" />

        <TextView
            android:id="@+id/tvFilterWide"
            style="@style/Widget.Zazor.FilterPill"
            android:layout_marginStart="8dp"
            android:text="@string/filter_wide" />

    </LinearLayout>

    <com.ernestoyaquello.dragdropswiperecyclerview.DragDropSwipeRecyclerView
        android:id="@+id/rvPhotos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="4dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/tvMetadataNote"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llFilters"
        tools:listitem="@layout/item_media" />

    <!-- The promise, where the files are: coordinates are on the picture and not inside it. -->
    <TextView
        android:id="@+id/tvMetadataNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/ds_accent_note"
        android:drawablePadding="11dp"
        android:lineSpacingExtra="3sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="@string/gallery_metadata_note"
        android:textColor="@color/ds_accent_text"
        android:textSize="12sp"
        app:drawableStartCompat="@drawable/ic_row_lock"
        app:drawableTint="@color/ds_accent_text"
        app:layout_constraintBottom_toTopOf="@id/flAd"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!--
      The only ad in the app. It sits under the feed, where someone is browsing rather than
      working, and collapses to nothing when there is no ad to show or the user has paid.
    -->
    <FrameLayout
        android:id="@+id/flAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ds_space_2"
        android:minHeight="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_photos"
        android:textColor="@color/ds_text_muted"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rvPhotos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/rvPhotos" />

</androidx.constraintlayout.widget.ConstraintLayout>
