<?xml version="1.0" encoding="utf-8"?>
<!-- One number about the day, readable off the map without touching anything. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/ds_dark_glass_stat"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/tvStatValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope"
        android:textColor="@color/ds_text_primary"
        android:textFontWeight="800"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="2,4 км" />

    <TextView
        android:id="@+id/tvStatLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/manrope"
        android:textColor="@color/ds_text_faint"
        android:textFontWeight="600"
        android:textSize="11sp"
        tools:text="маршрут" />

</LinearLayout>
