<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clOption"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ds_surface_card"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="72dp"
    android:padding="@dimen/ds_space_4">

    <TextView
        android:id="@+id/tvOptionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/ds_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="В мессенджер" />

    <TextView
        android:id="@+id/tvOptionHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_1"
        android:textColor="@color/ds_text_muted"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvOptionTitle"
        tools:text="Снимки уходят как есть" />

</androidx.constraintlayout.widget.ConstraintLayout>
