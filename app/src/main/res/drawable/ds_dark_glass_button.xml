<?xml version="1.0" encoding="utf-8"?>
<!-- A round control floating over the drawn map. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/ds_dark_glass_stat" />
            <stroke android:width="1dp" android:color="@color/ds_dark_glass_edge" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ds_dark_glass" />
            <stroke android:width="1dp" android:color="@color/ds_dark_glass_edge" />
        </shape>
    </item>
</selector>
