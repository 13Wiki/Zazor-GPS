<?xml version="1.0" encoding="utf-8"?>
<!-- The one button on a screen that takes something away for good. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/ds_danger_round" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ds_danger_surface" />
        </shape>
    </item>
</selector>
