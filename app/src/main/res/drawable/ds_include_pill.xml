<?xml version="1.0" encoding="utf-8"?>
<!-- What travels with the photos: accent when it is coming along, quiet when it is not. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/ds_accent" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/ds_surface_pill" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
