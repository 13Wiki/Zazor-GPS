<?xml version="1.0" encoding="utf-8"?>
<!--
  Shutter: an accent disc inside a glass ring, 80dp across with a 62dp disc, as the mockup draws
  it. The ring is what makes it visible over a bright frame.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ds_glass_shutter" />
            <stroke android:width="1dp" android:color="@color/ds_glass_edge_shutter" />
        </shape>
    </item>
    <item android:left="9dp" android:top="9dp" android:right="9dp" android:bottom="9dp">
        <shape android:shape="oval">
            <solid android:color="@color/ds_accent" />
        </shape>
    </item>
</layer-list>
