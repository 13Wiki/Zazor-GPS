<?xml version="1.0" encoding="utf-8"?>
<!-- Shutter: an accent disc inside a glass ring, so it reads against any scene. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ds_glass_strong" />
            <stroke android:width="1dp" android:color="@color/ds_glass_outline" />
        </shape>
    </item>
    <item android:left="7dp" android:top="7dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="oval">
            <solid android:color="@color/ds_accent" />
        </shape>
    </item>
</layer-list>
