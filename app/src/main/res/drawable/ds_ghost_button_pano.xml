<?xml version="1.0" encoding="utf-8"?>
<!-- The quieter of the review screen's two buttons. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/ds_surface_pill" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/ds_surface_round" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
