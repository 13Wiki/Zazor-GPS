<?xml version="1.0" encoding="utf-8"?>
<!--
  Chrome laid over the live frame. Dark, not the white glass used on dark surfaces: the frame can
  be a snow field or a white wall, and white-on-white made the signal reading disappear exactly
  where it matters most.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/ds_photo_scrim" />
    <stroke android:width="1dp" android:color="@color/ds_glass_outline" />
    <corners android:radius="999dp" />
</shape>
