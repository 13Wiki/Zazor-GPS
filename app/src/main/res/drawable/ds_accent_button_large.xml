<?xml version="1.0" encoding="utf-8"?>
<!-- The loud half of a pair of buttons: accent, 18dp corners, as the design draws them. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/ds_accent_pressed" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/ds_accent" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
