<?xml version="1.0" encoding="utf-8"?>
<!-- The quiet button at the foot of the sheet: white at a tenth, 16dp corners. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/ds_surface_pill" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/ds_surface_round" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
