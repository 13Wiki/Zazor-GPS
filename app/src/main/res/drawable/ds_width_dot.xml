<?xml version="1.0" encoding="utf-8"?>
<!-- One of the three line widths; the chosen one is solid white, the rest are dimmed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/ds_text_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ds_width_dot_idle" />
        </shape>
    </item>
</selector>
