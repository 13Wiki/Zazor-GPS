<?xml version="1.0" encoding="utf-8"?>
<!-- The day being looked at, tappable to change it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/ds_dark_glass_stat" />
            <stroke android:width="1dp" android:color="@color/ds_dark_glass_edge" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/ds_dark_glass" />
            <stroke android:width="1dp" android:color="@color/ds_dark_glass_edge" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
