<?xml version="1.0" encoding="utf-8"?>
<!-- Saving: the accent button at the foot of the sheet, 16dp corners. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/ds_accent_pressed" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/ds_accent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
