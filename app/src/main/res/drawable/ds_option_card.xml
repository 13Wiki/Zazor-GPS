<?xml version="1.0" encoding="utf-8"?>
<!-- A way of sending: outlined in accent while it is the chosen one. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/ds_accent_surface" />
            <stroke android:width="1.5dp" android:color="@color/ds_accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/ds_surface_sheer" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
