<?xml version="1.0" encoding="utf-8"?>
<!-- The switch the design draws: 51 by 31, green when on, white at a fifth when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <solid android:color="@color/ds_signal_good" />
            <corners android:radius="999dp" />
            <size android:width="51dp" android:height="31dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/ds_glass_chip" />
            <corners android:radius="999dp" />
            <size android:width="51dp" android:height="31dp" />
        </shape>
    </item>
</selector>
