<?xml version="1.0" encoding="utf-8"?>
<!-- A settable value on its own line: white at six per cent over a ten per cent hairline. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/ds_surface_faint" />
            <stroke android:width="1dp" android:color="@color/ds_surface_round" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/ds_surface_sheer" />
            <stroke android:width="1dp" android:color="@color/ds_surface_round" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
