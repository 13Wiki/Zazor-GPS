<?xml version="1.0" encoding="utf-8"?>
<!-- A filter is chosen or it is not; the pill says which without a tick or a border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_text_primary" />
            <corners android:radius="999dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_surface_raised" />
            <corners android:radius="999dp" />
        </shape>
    </item>

</selector>
