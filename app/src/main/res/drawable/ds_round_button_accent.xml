<?xml version="1.0" encoding="utf-8"?>
<!-- The one action a screen is really for: the design paints that button accent. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/ds_accent_pressed" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ds_accent" />
        </shape>
    </item>
</selector>
