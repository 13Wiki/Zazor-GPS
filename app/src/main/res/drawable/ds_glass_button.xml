<?xml version="1.0" encoding="utf-8"?>
<!-- A square glass button beside the shutter: same material as the pills, 18dp corners. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/ds_glass_shutter" />
            <stroke android:width="1dp" android:color="@color/ds_glass_edge_card" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/ds_glass_pill" />
            <stroke android:width="1dp" android:color="@color/ds_glass_edge_card" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
