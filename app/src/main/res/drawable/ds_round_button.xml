<?xml version="1.0" encoding="utf-8"?>
<!-- A round button on a dark screen: white at a tenth, as the design draws its headers. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/ds_surface_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ds_surface_round" />
        </shape>
    </item>
</selector>
